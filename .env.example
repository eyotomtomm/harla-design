# Database (MySQL). Special characters in the password must be URL-encoded:
#   @ -> %40   ? -> %3F   # -> %23   / -> %2F   : -> %3A
# On Hostinger the host is "localhost" from inside the hosting account.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD_ENCODED@localhost:3306/DB_NAME"

# NextAuth (admin sessions). Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://harladesign.com"

# Admin login created by `npm run seed`
ADMIN_EMAIL="admin@harladesign.com"
ADMIN_PASSWORD=""

# Contact form email delivery (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@harladesign.com"
SMTP_PASS=""
