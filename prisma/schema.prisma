generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String
  name           String   @default("Admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Copy for the home "Who we are" section and the About page. One row.
model AboutPage {
  id          Int      @id @default(autoincrement())
  homeHeading String   @default("Built on conviction, *delivered with care.*")
  heading     String   @default("Strategy first, *design for impact.*")
  intro       String   @db.Text
  intro2      String?  @db.Text
  mission     String   @db.Text
  vision      String   @db.Text
  vision2     String?  @db.Text
  /// Longer story paragraphs, separated by blank lines
  story       String   @db.Text
  bannerImage String   @default("/images/projects/abay-bank/lobby-2.jpg")
  aboutImage  String   @default("/images/projects/africa-cdc/headquarters.jpg")
  hoverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The six "Our approach" items.
model ApproachItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String   @default("fas fa-compass")
  link        String   @default("/about")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A row on the Projects page (Lifestyle, Institutions, ...).
model ProjectCategory {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String         @default("")
  sortOrder   Int            @default(0)
  images      GalleryImage[]
}

/// One tile in the gallery: client · type · location.
model GalleryImage {
  id         Int             @id @default(autoincrement())
  client     String
  type       String
  location   String?
  image      String
  alt        String          @default("")
  sortOrder  Int             @default(0)
  categoryId Int
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model WorkProcessStep {
  id          Int      @id @default(autoincrement())
  stepNumber  Int
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id              Int      @id @default(autoincrement())
  siteName        String   @default("Harla Design")
  contactPhone    String   @default("+971 523 797 567")
  contactEmail    String   @default("contact@harladesign.com")
  contactAddress  String   @default("SS Tower, 63rd Street")
  contactAddress2 String   @default("Al Barsha South 3, Dubai UAE")
  footerText1     String   @default("Have a project in mind? Let's build something *remarkable* together.")
  footerText2     String   @default("Get in touch — we're ready when you are.")
  copyrightText   String   @default("")
  socialInstagram String   @default("https://www.instagram.com/harla_designs")
  socialSpotify   String   @default("https://open.spotify.com/show/033jiFuYnZa19SQaeDLVtX")
  socialSubstack  String   @default("https://beneatheconcrete.substack.com")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactSubmission {
  id           Int      @id @default(autoincrement())
  name         String
  organisation String?
  email        String
  message      String   @db.Text
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}
